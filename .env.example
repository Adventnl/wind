# The server binds to loopback by default; put it behind an HTTPS reverse proxy.
HOST=127.0.0.1
PORT=3001
NODE_ENV=production
# Comma-separated origins, with no trailing slashes. Required for native clients.
ALLOWED_ORIGINS=https://wind.example.com,capacitor://localhost,https://localhost,wind://app
# Optional coturn REST credentials. This secret stays on the server.
# TURN_URLS=turn:turn.example.com:3478,turns:turn.example.com:5349
# TURN_SECRET=replace-with-a-long-random-secret
# For packaged apps, bake your HTTPS server URL into the client at build time.
# VITE_SIGNAL_URL=https://wind.example.com
